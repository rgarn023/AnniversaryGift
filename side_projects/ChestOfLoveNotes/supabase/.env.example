# Copy to .env / .env.local for `supabase functions serve` — never commit real values.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 32-byte key as base64 (openssl rand -base64 32) or 64-char hex
MESSAGE_ENCRYPTION_KEY=replace-me-with-openssl-rand-base64-32
